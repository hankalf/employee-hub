# Copy these into Railway → your Employee Hub service → Variables (see README)

# REQUIRED: password for the admin area at /admin
ADMIN_PASSWORD=change-me-to-something-long

# Optional: random string used to sign the admin login cookie (auto-generated and kept on the Volume if empty)
SESSION_SECRET=

# Optional: where settings and the logo are stored. On Railway this defaults to the attached Volume automatically.
DATA_DIR=

# Optional: the public web address of the hub, used for the QR code (defaults to the address the page is opened on)
PUBLIC_URL=

# Optional: sites allowed to show the hub inside a frame. Default:
#   https://monday.com https://*.monday.com https://*.monday.app
# Space- or comma-separated https origins; "none" = only the hub itself.
FRAME_ANCESTORS=

# Optional: a monday.com API token, only needed to send alerts as items on a monday.com board
# (monday.com → your avatar → Developers → My access tokens)
MONDAY_API_TOKEN=
